# ==============================================================================
# CareerTrack - Variables d'environnement pour l'environnement de développement
# ==============================================================================

# --- Base de données PostgreSQL ---
DB_HOST=postgres
DB_PORT=5434
DB_NAME=careertrack_db
DB_USER=careertrack_user
DB_PASSWORD=careertrack_secure_password_2026

# --- Backend Spring Boot ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Sécurité JWT (Minimum 256 bits / 32 caractères pour HMAC-SHA256)
JWT_SECRET=4c9a63c6218e8d2e8b23c21a4f59e0a9b8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3
JWT_ACCESS_EXPIRATION_MS=900000        # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000    # 7 jours

# CORS - Motifs d'origines autorisées (séparés par des virgules)
# En dev : autorise tous les ports locaux (ex: http://localhost:*,http://127.0.0.1:*)
# En production : mettre UNIQUEMENT l'URL du frontend déployé (Vercel ou Netlify, ex: https://careertrack.vercel.app), sans les motifs localhost.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Configuration Serveur Mail (SMTP pour notifications de recrutement)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications.careertrack@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_application_google
MAIL_FROM=no-reply@careertrack.sn

# Paramètres Légaux & Entreprise (Code du Travail du Sénégal)
CAREERTRACK_CURRENCY=XOF
CAREERTRACK_LEAVE_DAYS_PER_MONTH=2.0
CAREERTRACK_MAX_CDD_MONTHS=24
CAREERTRACK_IPRES_RATE_EMPLOYEE=0.056
CAREERTRACK_IPRES_RATE_EMPLOYER=0.084
CAREERTRACK_CSS_RATE_EMPLOYER=0.070

# --- Frontend React Vite ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
